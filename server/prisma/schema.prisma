generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  AFFILIATE
  SUPER_ADMIN
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
}

model User {
  id                    String         @id @default(uuid())
  email                 String         @unique
  passwordHash          String
  passwordPlain         String?
  name                  String
  role                  Role           @default(AFFILIATE)
  defaultCommissionRate Float          @default(0.20)
  active                Boolean        @default(true)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  discountCodes         DiscountCode[]
  payouts               Payout[]
}

model DiscountCode {
  id                     String    @id @default(uuid())
  code                   String    @unique
  affiliateId            String
  affiliate              User      @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  discountPercent        Float     @default(0.10)
  commissionRateOverride Float?
  label                  String?
  active                 Boolean   @default(true)
  expiresAt              DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  orders                 Order[]

  @@index([affiliateId])
  @@index([code])
}

model Order {
  id                String        @id @default(uuid())
  externalOrderId   String?
  discountCodeId    String?
  discountCode      DiscountCode? @relation(fields: [discountCodeId], references: [id])
  customerFirstName String
  itemsSummary      String
  orderTotal        Float
  commissionEarned  Float         @default(0)
  attributed        Boolean       @default(false)
  source            String        @default("shopify")
  createdAt         DateTime      @default(now())

  @@index([discountCodeId])
  @@index([createdAt])
}

model Payout {
  id          String       @id @default(uuid())
  affiliateId String
  affiliate   User         @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  amount      Float
  period      String
  status      PayoutStatus @default(PENDING)
  notes       String?
  paidAt      DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([affiliateId])
}
