generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  AFFILIATE
  SUPER_ADMIN
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
}

model User {
  id                    String             @id @default(uuid())
  email                 String             @unique
  passwordHash          String
  passwordPlain         String?
  name                  String
  role                  Role               @default(AFFILIATE)
  defaultCommissionRate Float              @default(0.20)
  active                Boolean            @default(true)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  discountCodes         DiscountCode[]
  payouts               Payout[]
  commissionSplits      CommissionSplit[]  @relation("SplitRecipient")
  orderCommissions      OrderCommission[]  @relation("OrderCommissionRecipient")
}

model DiscountCode {
  id                     String            @id @default(uuid())
  code                   String            @unique
  affiliateId            String
  affiliate              User              @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  discountPercent        Float             @default(0.10)
  commissionRateOverride Float?
  label                  String?
  active                 Boolean           @default(true)
  expiresAt              DateTime?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  orders                 Order[]
  splits                 CommissionSplit[]

  @@index([affiliateId])
  @@index([code])
}

model Order {
  id                String            @id @default(uuid())
  externalOrderId   String?
  discountCodeId    String?
  discountCode      DiscountCode?     @relation(fields: [discountCodeId], references: [id])
  customerFirstName String
  customerLastName  String?
  itemsSummary      String
  orderTotal        Float
  commissionEarned  Float             @default(0)
  attributed        Boolean           @default(false)
  source            String            @default("shopify")
  storeName         String?
  currency          String            @default("USD")
  createdAt         DateTime          @default(now())
  commissions       OrderCommission[]

  @@index([discountCodeId])
  @@index([createdAt])
}

// Per-discount-code rule for splitting commission among recipients.
// If a code has no splits, 100% of the commission goes to the code's affiliate.
// sharePercent values must sum to 1.0 across all splits for a given code.
model CommissionSplit {
  id              String       @id @default(uuid())
  discountCodeId  String
  discountCode    DiscountCode @relation(fields: [discountCodeId], references: [id], onDelete: Cascade)
  recipientUserId String
  recipientUser   User         @relation("SplitRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  sharePercent    Float
  note            String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([discountCodeId])
  @@index([recipientUserId])
}

// Per-order ledger of what each recipient actually earned. Written at webhook
// time and is the source of truth for affiliate earnings and payout math.
// Sums up to Order.commissionEarned (the order's total commission pool).
model OrderCommission {
  id              String   @id @default(uuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  recipientUserId String
  recipientUser   User     @relation("OrderCommissionRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  amount          Float
  sharePercent    Float    @default(1.0)
  createdAt       DateTime @default(now())

  @@index([orderId])
  @@index([recipientUserId])
}

model Payout {
  id          String       @id @default(uuid())
  affiliateId String
  affiliate   User         @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  amount      Float
  period      String
  status      PayoutStatus @default(PENDING)
  notes       String?
  paidAt      DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([affiliateId])
}

// ============ LOGGING ============

enum LogLevel {
  INFO
  WARN
  ERROR
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  userEmail   String?
  userName    String?
  userRole    String?
  action      String   // e.g. "LOGIN", "CREATE_AFFILIATE", "DELETE_ORDER"
  entity      String?  // e.g. "User", "Order", "DiscountCode"
  entityId    String?
  details     String?  // JSON string with extra context
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([entity])
}

model SystemLog {
  id         String   @id @default(uuid())
  level      LogLevel @default(INFO)
  source     String   // e.g. "WEBHOOK", "API", "AUTH", "SYSTEM"
  message    String
  details    String?  // JSON string with stack traces, payloads, etc.
  createdAt  DateTime @default(now())

  @@index([level])
  @@index([source])
  @@index([createdAt])
}
